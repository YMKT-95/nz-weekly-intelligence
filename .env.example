# Optional OpenAI interpretation; use none for fully local template reports.
LLM_PROVIDER=openai
# Paste your own API key only in .env, never in this tracked example.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini-2025-04-14
LLM_TIMEOUT_SECONDS=45
# Search integration remains deferred.
SEARCH_API_KEY=

# Reports use Monday-Sunday weeks in this timezone.
REPORT_TIMEZONE=Pacific/Auckland

# HTTP connect/read/write/pool timeout, in seconds (greater than 0, at most 120).
RESEARCH_TIMEOUT_SECONDS=20
