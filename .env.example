# Direct-source research runs without API credentials. LLM/search integration is deferred.
LLM_API_KEY=
LLM_MODEL=
SEARCH_API_KEY=

# Reports use Monday-Sunday weeks in this timezone.
REPORT_TIMEZONE=Pacific/Auckland

# HTTP connect/read/write/pool timeout, in seconds (greater than 0, at most 120).
RESEARCH_TIMEOUT_SECONDS=20
